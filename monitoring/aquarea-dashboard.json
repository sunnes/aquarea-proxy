      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "none",
                  "color": "green"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "156": {
                  "text": "H76",
                  "color": "red"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "38": {
                  "text": "H72",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
