# Copy to secrets.env (gitignored) and fill in. Read by:
#   - the PlatformIO build (scripts/pio_secrets.py): firmware passwords, OTA upload target
#   - scripts/aquarea.sh: API host and password (environment variables override)
# The HTTP API user name is always "aquarea".

# One password for OTA upload, the fallback access point (WPA2, 8+ characters) and the HTTP API.
DEVICE_PASSWORD=change-me-long-random
# IP address or host name of the proxy on your network (used for OTA upload and the CLI).
AQUAREA_HOST=192.0.2.10
